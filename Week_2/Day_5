1.GROUP ANAGRAMS:
class Solution {
public:
    vector<vector<string>> groupAnagrams(vector<string>& strs) {
        unordered_map<string, vector<string>> mp;
        for(auto x:strs){
            string word=x;
            sort(word.begin(),word.end());
            mp[word].push_back(x);
        }
        vector<vector<string>> ans;
        for(auto x: mp){
            ans.push_back(x.second);
        }
        return ans;
        
    }
};
2.STRING COMPRESSION:
class Solution {
public:
    int compress(vector<char>& chars) {
        int i=0;
        vector<string> s;
        if(chars.size()==1){
            return chars.size();
        }
        while (i < chars.size()){
            int j =i;
            int cnt = 0;

            s.push_back(string(1, chars[i]));
            while (j <chars.size() && chars[i] == chars[j]){
                j++;
                cnt++;
            }
            if(cnt>1){
                s.push_back(to_string(cnt));
            }
            i=j;
        }
        chars.clear();

        for(int i=0;i< s.size();i++){
            for(int j=0;j < s[i].size();j++){
                chars.push_back(s[i][j]);
            }
        }
        return chars.size();
    }
};
3.LONGEST PALINDROME SUBSTRING:
class Solution {
public:
    string longestPalindrome(string s) {
        int n =s.size();
        string res = "";

        for( int i=0;i<n;i++){
            int st=i,end=i;
            while(st>=0&&end<n&&s[st]==s[end]){
                st--;
                end++;
            }
            string temp=s.substr(st+1,end-st-1);
            if(temp.size()>res.size())res=temp;
            st=i;
            end=i+1;
            while(st>=0&&end<n&&s[st]==s[end]){
                st--;
                end++;
            }
            temp=s.substr(st+1,end-st-1);
            if(temp.size()>res.size())res=temp;
        }
        return res;
        
    }
};
