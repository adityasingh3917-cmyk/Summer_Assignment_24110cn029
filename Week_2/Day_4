1.REVERSE WORDS IN A STRING III:
class Solution {
public:
    string reverseWords(string s) {
        int start=0;
        int end=0;
        for(end;end<=s.size();end++){
            if(end == s.size() || s[end]==' '){
                reverse(s.begin() + start, s.begin() + end);
                start =end +1;
            }
        }
        return s;
        
    }
};
2.DECODE STRING:
class Solution {
public:
    string decodeString(string s) {
        int i=0;
        return decode(s,i);
        
    }
    string decode(const string& s, int& i){
        string result = "";
        int num =0;
        while(i < s.size()){
            char c = s[i];
            if(isdigit(c)){
                num = num * 10 + (c - '0');
                i++;
            } else if (c == '['){
                i++;
                string inner = decode(s,i);
                for (int k=0; k < num; k++) result +=inner;
                num =0;
            }else if (c ==']'){
                i++;
                return result;
            } else {
                result +=c;
                i++;
            }
        }
        return result;
    }
};
3.GENERATE PARENTHESES:
class Solution {
public:
    vector<string> generateParenthesis(int n) {
        vector<string> res;
        addingpar( res, "",n,0);
        return res;
        
    }
    void addingpar(vector<string> &v, string str, int n ,int m){
        if(n==0 && m==0){
            v.push_back(str);
            return;
        }
        if(m>0){ addingpar(v, str+")",n,m-1);}
        if(n>0){ addingpar(v, str+"(", n-1,m+1);}
    }
};
